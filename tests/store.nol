import "../src/store.nol"

fn test_twitch_persistance() {
    assert(store_initialiser("store.sqlite3"), "base SQLite initialisée")
    assert(store_twitch_abonner("guild-test", "channel-test", "streamer_test"), "abonnement Twitch enregistré")
    assert(store_twitch_compter("guild-test") == 1, "abonnement Twitch compté")
    let lignes = store_twitch_du("guild-test")
    assert(has(lignes), "abonnement Twitch relu")
    assert(contains(unwrap_or(lignes, ""), "channel-test|streamer_test|-1"), "état initial conservé")
    assert(store_twitch_etat("guild-test", "streamer_test", 1), "état Twitch mis à jour")
    assert(store_twitch_desabonner("guild-test", "streamer_test"), "abonnement Twitch supprimé")
    assert(store_twitch_compter("guild-test") == 0, "abonnement Twitch absent après suppression")
    assert(store_configurer("guild-test", "faq.comment_demander_de_l_aide", "Ouvre un ticket."), "FAQ enregistrée")
    assert(store_configurer("guild-test", "verification.code", "secret-test"), "code de vérification enregistré")
    assert(not contains(unwrap_or(store_lister_cles("guild-test"), ""), "verification.code"), "code de vérification absent de la liste publique")
    assert(has(store_lister_faq("guild-test")), "FAQ listée")
    assert(unwrap_or(store_lire("guild-test", "faq.comment_demander_de_l_aide"), "") == "Ouvre un ticket.", "FAQ relue")
    assert(store_configurer("guild-test", "faq.comment_demander_de_l_aide", "Utilise /ticket."), "FAQ remplacée")
    assert(unwrap_or(store_lire("guild-test", "faq.comment_demander_de_l_aide"), "") == "Utilise /ticket.", "FAQ remplacée relue")
    assert(store_supprimer("guild-test", "faq.comment_demander_de_l_aide"), "FAQ supprimée")
    assert(not has(store_lire("guild-test", "faq.comment_demander_de_l_aide")), "FAQ absente après suppression")
    assert(store_log_action("guild-test", "user-test", "command_user:user-test:ping", "", "test"), "journal commande 1")
    assert(store_log_action("guild-test", "user-test", "command_user:user-test:faq", "", "test"), "journal commande 2")
    assert(store_compter_recent_prefixe("guild-test", "command_user:user-test:", 60) == 2, "rate-limit par préfixe")
    assert(store_compter_recent("guild-test", "command_user:user-test:ping", 60) == 1, "événement récent compté")
    assert(store_compter_recent_prefixe("guild-test", "command_user:user-test:", 1) >= 1, "fenêtre courte récente comptée")
    assert(store_log_action("guild-test", "modo-test", "warn", "member-test", "Avertissement de test"), "sanction test enregistrée")
    let sanction_test_id = store_dernier_audit_id("guild-test", "modo-test", "warn", "member-test")
    assert(sanction_test_id > 0, "identifiant de sanction attribué")
    assert(store_sanction_existe("guild-test", sanction_test_id), "sanction retrouvée dans son serveur")
    assert(not store_sanction_existe("guild-test", 999999), "sanction inexistante refusée")
    assert(store_compter_cible("guild-test", "warn", "member-test") == 1, "sanction active comptée")
    assert(store_log_action("guild-test", "modo-test", "sanction_revoke", text(sanction_test_id), "Erreur reconnue"), "révocation auditée")
    assert(store_compter_cible("guild-test", "warn", "member-test") == 0, "sanction révoquée exclue du compteur")
    assert(store_configurer("guild-test", "voice.seconds.user-test", "120"), "voix test enregistrée")
    assert(store_configurer("guild-test", "xp.last.user-test", "123"), "dernier gain XP test enregistré")
    assert(store_configurer("guild-test", "member.note.user-test", "note privée"), "note test enregistrée")
    assert(store_configurer("guild-test", "music.votes.123.user-test", "1"), "vote musical test enregistré")
    assert(store_configurer("guild-test", "poll.42.vote.user-test", "oui"), "vote sondage test enregistré")
    assert(store_configurer("guild-test", "verification.pending.user-test", "123"), "vérification en attente test enregistrée")
    assert(store_configurer("guild-test", "privacy.suggestion.42.user-test", "1"), "propriétaire suggestion anonyme test enregistré")
    assert(store_supprimer_donnees("guild-test", "user-test"), "suppression des données personnelles")
    assert(not has(store_lire("guild-test", "voice.seconds.user-test")), "temps vocal supprimé")
    assert(not has(store_lire("guild-test", "xp.last.user-test")), "dernier gain XP supprimé")
    assert(not has(store_lire("guild-test", "member.note.user-test")), "note privée supprimée")
    assert(not has(store_lire("guild-test", "music.votes.123.user-test")), "vote musical supprimé")
    assert(not has(store_lire("guild-test", "poll.42.vote.user-test")), "vote sondage supprimé")
    assert(not has(store_lire("guild-test", "verification.pending.user-test")), "vérification en attente supprimée")
    assert(not has(store_lire("guild-test", "privacy.suggestion.42.user-test")), "propriétaire suggestion anonyme supprimé")
    assert(not has(store_classement_invitations("guild-test")), "classement vide sans utilisation")
    assert(store_observer_invitation("guild-test", "abc123", 2, "inviter-test") == -1, "première observation invitation")
    assert(store_observer_invitation("guild-test", "abc123", 5, "inviter-test") == 2, "delta invitation observé")
    assert(store_log_action("guild-test", "inviter-test", "invite_use", "abc123", "2 -> 5"), "utilisation invitation auditée")
    assert(has(store_classement_invitations("guild-test")), "classement invitations disponible")
    assert(store_log_action("guild-test", "system", "invite_suspect", "abc123", "Créateur absent"), "alerte invitation suspecte enregistrée")
    assert(store_compter("guild-test", "invite_suspect") == 1, "alerte invitation suspecte comptée")
    assert(store_log_action("guild-test", "proposer-test", "partnership_request", "Projet Test", "https://example.com\ndescription"), "demande partenariat enregistrée")
    assert(has(store_lister_partenariats("guild-test")), "demandes partenariat listées")
    assert(store_configurer("guild-test", "meme.1", "Meme test"), "meme personnalisé enregistré")
    assert(unwrap_or(store_lire("guild-test", "meme.1"), "") == "Meme test", "meme personnalisé relu")
    assert(store_supprimer("guild-test", "meme.1"), "meme personnalisé supprimé")
    assert(store_configurer("guild-test", "music.queue.1", "https://example.com/one"), "file musicale entrée 1")
    assert(store_configurer("guild-test", "music.queue.2", "https://example.com/two"), "file musicale entrée 2")
    let file_music = store_lister_prefixe("guild-test", "music.queue.", 50)
    assert(has(file_music), "file musicale relue")
    assert(contains(unwrap_or(file_music, ""), "1|https://example.com/one"), "première piste persistée")
    assert(contains(unwrap_or(file_music, ""), "2|https://example.com/two"), "deuxième piste persistée")
    assert(store_supprimer_prefixe("guild-test", "music.queue."), "file musicale vidée")
    assert(not has(store_lister_prefixe("guild-test", "music.queue.", 50)), "file musicale vide après suppression")
    assert(store_configurer("guild-test", "voice.temp.channel-test", "user-test"), "salon vocal temporaire enregistré")
    assert(unwrap_or(store_lire("guild-test", "voice.temp.channel-test"), "") == "user-test", "salon vocal temporaire relu")
    assert(store_supprimer("guild-test", "voice.temp.channel-test"), "salon vocal temporaire nettoyé")
    assert(not has(store_lire("guild-test", "voice.temp.channel-test")), "salon vocal temporaire absent après nettoyage")
    assert(store_configurer("guild-test", "voice.temp.channel-test", "user-test"), "registre vocal pour compteur")
    assert(store_configurer("guild-test", "voice.temp.member.channel-test.user-test", "1"), "membre vocal enregistré")
    assert(store_compter_cles_prefixe("guild-test", "voice.temp.member.channel-test.") == 1, "membre vocal compté")
    assert(store_supprimer_prefixe("guild-test", "voice.temp.member.channel-test."), "membres vocaux nettoyés")
}

fn main() {
    test_twitch_persistance()
    print("store persistence ok")
}
