import "../src/time.nol"

fn test_epoch_unix() {
    assert(iso8601(0) == "1970-01-01T00:00:00Z", "epoch Unix")
}

fn test_epoch_apres() {
    assert(iso8601(86400) == "1970-01-02T00:00:00Z", "jour suivant")
    assert(iso8601(3600 + 60 + 1) == "1970-01-01T01:01:01Z", "heure minute seconde")
    assert(iso8601(-1) == "1969-12-31T23:59:59Z", "seconde avant epoch")
}

fn test_dates_bissextiles() {
    assert(iso8601(951782400) == "2000-02-29T00:00:00Z", "29 février 2000")
    assert(iso8601(2145916800) == "2038-01-01T00:00:00Z", "date 2038")
}

fn test_decalage_utc() {
    assert(epoch_decalage_utc(0, 2) == 7200, "décalage positif")
    assert(epoch_decalage_utc(0, -5) == -18000, "décalage négatif")
}

fn main() {}
