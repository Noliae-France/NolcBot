fn discord_timeout(req: Requete, secondes: Int) -> Bool {
    let tok = bot_token()
    let guild = interaction_guild(req)
    let user = interaction_cible(req)
    if not has(tok) or guild == "" or user == "" or secondes < 0 { return false }
    let fin = epoch_maintenant() + secondes
    var corps = "{\"communication_disabled_until\":null}"
    if secondes > 0 { corps = "{\"communication_disabled_until\":\"" + iso8601(fin) + "\"}" }
    let rep = discord_rest("PATCH", "/api/v10/guilds/" + guild + "/members/" + user, unwrap_or(tok, ""), corps)
    if not has(rep) { return false }
    let code = http_statut(unwrap_or(rep, ""))
    return code == 200
}

fn discord_timeout_identifiant(token: Text, guild: Text, user: Text, secondes: Int) -> Bool {
    if token == "" or guild == "" or user == "" or secondes < 0 { return false }
    let fin = epoch_maintenant() + secondes
    var corps = "{\"communication_disabled_until\":null}"
    if secondes > 0 { corps = "{\"communication_disabled_until\":\"" + iso8601(fin) + "\"}" }
    let rep = discord_rest("PATCH", "/api/v10/guilds/" + guild + "/members/" + user, token, corps)
    if not has(rep) { return false }
    let code = http_statut(unwrap_or(rep, ""))
    return code == 200
}

fn discord_modifier_surnom(req: Requete, surnom: Text) -> Bool {
    let tok = bot_token()
    let guild = interaction_guild(req)
    let user = interaction_cible(req)
    if not has(tok) or guild == "" or user == "" or len(surnom) > 32 { return false }
    let corps = "{\"nick\":" + json_texte(surnom) + "}"
    let rep = discord_rest("PATCH", "/api/v10/guilds/" + guild + "/members/" + user, unwrap_or(tok, ""), corps)
    if not has(rep) { return false }
    return http_statut(unwrap_or(rep, "")) == 200
}

fn discord_slowmode(req: Requete, secondes: Int) -> Bool {
    let tok = bot_token()
    let salon = unwrap_or(json_chemin_texte(req.corps, "channel_id"), "")
    if not has(tok) or salon == "" or secondes < 0 or secondes > 21600 { return false }
    let corps = "{\"rate_limit_per_user\":" + text(secondes) + "}"
    let rep = discord_rest("PATCH", "/api/v10/channels/" + salon, unwrap_or(tok, ""), corps)
    if not has(rep) { return false }
    return http_statut(unwrap_or(rep, "")) == 200
}

fn discord_modifier_salon(token: Text, salon: Text, champ: Text, valeur: Text) -> Bool {
    if token == "" or salon == "" or champ == "" { return false }
    var corps = "{}"
    if champ == "name" {
        if valeur == "" or len(valeur) > 100 { return false }
        corps = "{\"name\":" + json_texte(valeur) + "}"
    }
    if champ == "topic" {
        if len(valeur) > 1024 { return false }
        corps = "{\"topic\":" + json_texte(valeur) + "}"
    }
    if champ == "slowmode" {
        let secondes = unwrap_or(parse_int(valeur), -1)
        if secondes < 0 or secondes > 21600 { return false }
        corps = "{\"rate_limit_per_user\":" + text(secondes) + "}"
    }
    if champ == "nsfw" {
        if valeur != "true" and valeur != "false" { return false }
        corps = "{\"nsfw\":" + valeur + "}"
    }
    if champ == "category" {
        corps = "{\"parent_id\":" + json_texte(valeur) + "}"
    }
    if champ == "position" {
        let position = unwrap_or(parse_int(valeur), -1)
        if position < 0 { return false }
        corps = "{\"position\":" + text(position) + "}"
    }
    if corps == "{}" { return false }
    let rep = discord_rest("PATCH", "/api/v10/channels/" + salon, token, corps)
    if not has(rep) { return false }
    return http_statut(unwrap_or(rep, "")) == 200
}

fn discord_supprimer_message(token: Text, salon: Text, message: Text) -> Bool {
    if salon == "" or message == "" { return false }
    let rep = discord_rest("DELETE", "/api/v10/channels/" + salon + "/messages/" + message, token, "")
    if not has(rep) { return false }
    let code = http_statut(unwrap_or(rep, ""))
    return code == 204 or code == 200
}

fn discord_supprimer_messages(token: Text, salon: Text, limite: Int) -> Int {
    if token == "" or salon == "" or limite < 2 or limite > 100 { return 0 }
    let rep = discord_rest("GET", "/api/v10/channels/" + salon + "/messages?limit=" + text(limite), token, "")
    if not has(rep) or http_statut(unwrap_or(rep, "")) != 200 { return 0 }
    let brut = unwrap_or(rep, "")
    let separateur = find(brut, "\r\n\r\n")
    if not has(separateur) { return 0 }
    let corps = sub(brut, unwrap_or(separateur, 0) + 4, len(brut) - unwrap_or(separateur, 0) - 4)
    var ids = "["
    var trouve = 0
    var index = 0
    while index < limite {
        let identifiant = json_chemin_texte(corps, text(index) + ".id")
        if not has(identifiant) { break }
        if trouve > 0 { ids += "," }
        ids += json_texte(unwrap_or(identifiant, ""))
        trouve = trouve + 1
        index = index + 1
    }
    ids += "]"
    if trouve < 2 { return 0 }
    let bulk = discord_rest("POST", "/api/v10/channels/" + salon + "/messages/bulk-delete", token, "{\"messages\":" + ids + "}")
    if not has(bulk) or http_statut(unwrap_or(bulk, "")) != 204 { return 0 }
    return trouve
}

