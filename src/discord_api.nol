// Opérations Discord nécessitant un appel REST authentifié.
import "nolc-discord::src/lib.nol"
import "time.nol"
import "store.nol"

fn bot_token() -> Option<Text> { return env("DISCORD_BOT_TOKEN") }

fn interaction_guild(req: Requete) -> Text {
    return unwrap_or(json_chemin_texte(req.corps, "guild_id"), "")
}

fn interaction_cible(req: Requete) -> Text {
    return unwrap_or(json_chemin_texte(req.corps, "data.options.0.value"), "")
}

fn discord_bannir(req: Requete) -> Bool {
    let tok = bot_token()
    let guild = interaction_guild(req)
    let user = interaction_cible(req)
    if not has(tok) or guild == "" or user == "" { return false }
    let rep = discord_rest("PUT", "/api/v10/guilds/" + guild + "/bans/" + user, unwrap_or(tok, ""), "{}")
    if not has(rep) { return false }
    let code = http_statut(unwrap_or(rep, ""))
    return code == 200 or code == 204
}

fn discord_expulser(req: Requete) -> Bool {
    let tok = bot_token()
    let guild = interaction_guild(req)
    let user = interaction_cible(req)
    if not has(tok) or guild == "" or user == "" { return false }
    let rep = discord_rest("DELETE", "/api/v10/guilds/" + guild + "/members/" + user, unwrap_or(tok, ""), "")
    if not has(rep) { return false }
    let code = http_statut(unwrap_or(rep, ""))
    return code == 200 or code == 204
}

