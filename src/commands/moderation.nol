import "nolc-discord::src/lib.nol"
import "../acl.nol"
import "../discord_api.nol"
import "../store.nol"

fn commande_moderation(req: Requete, nom: Text) -> Option<Reponse> {
    if nom != "lock" and nom != "unlock" { return none }
    if not acl_autorise(req.corps, "lock") { return some(acl_refus("lock")) }
    let verrou = nom == "lock"
    if not discord_verrouiller_salon(req, verrou) { return some(discord_reponse_ephemere("❌ Impossible de modifier les permissions du salon.")) }
    let guild = unwrap_or(json_chemin_texte(req.corps, "guild_id"), "")
    let actor = unwrap_or(json_chemin_texte(req.corps, "member.user.id"), "")
    let channel = unwrap_or(json_chemin_texte(req.corps, "channel_id"), "")
    let _log = store_log_action(guild, actor, nom, channel, "Salon")
    if verrou { return some(discord_reponse_message("🔒 Salon verrouillé.")) }
    return some(discord_reponse_message("🔓 Salon déverrouillé."))
}
