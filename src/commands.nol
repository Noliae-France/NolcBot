        let question_faq_ai = unwrap_or(json_chemin_texte(req.corps, "data.options.0.value"), "")
        if guild_faq_ai == "" or question_faq_ai == "" or len(question_faq_ai) > 500 { return discord_reponse_ephemere("❌ Question FAQ invalide.") }
        let direct_faq_ai = store_lire(guild_faq_ai, "faq." + lower(question_faq_ai))
        if has(direct_faq_ai) { return discord_reponse_message("❓ " + unwrap_or(direct_faq_ai, "")) }
        let entries_faq_ai = store_lister_prefixe(guild_faq_ai, "faq.", 50)
        if not has(entries_faq_ai) { return discord_reponse_ephemere("❓ La FAQ de ce serveur est vide.") }
        let ai_faq_active = store_lire(guild_faq_ai, "ai.enabled")
        if has(ai_faq_active) and unwrap_or(ai_faq_active, "") == "false" { return discord_reponse_ephemere("❓ Réponse absente. La recherche IA FAQ est désactivée pour ce serveur.") }
        let auteur_faq_ai = unwrap_or(json_chemin_texte(req.corps, "member.user.id"), "")
        if store_compter_recent(guild_faq_ai, "ai_user:" + auteur_faq_ai, 60) >= 5 { return discord_reponse_ephemere("⏳ Limite IA atteinte : 5 requêtes par minute.") }
        let _faq_ai_usage = store_log_action(guild_faq_ai, auteur_faq_ai, "ai_user:" + auteur_faq_ai, "", "Recherche FAQ IA")
        let prompt_faq_ai = "Réponds uniquement avec la réponse FAQ la plus pertinente, ou dis exactement 'Aucune réponse trouvée' si aucune entrée ne correspond. Question : " + question_faq_ai + "\nEntrées FAQ :\n" + unwrap_or(entries_faq_ai, "")
        let resultat_faq_ai = integration_ai(guild_faq_ai, prompt_faq_ai)
        if has(resultat_faq_ai) { return discord_reponse_message("🤖 " + integration_texte_sans_mentions(unwrap_or(resultat_faq_ai, ""))) }
