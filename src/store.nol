}

fn store_rss_du(guild: Text) -> Option<Text> {
    let db = store_ouvrir("noliae-discord.sqlite3")
    if ptr_est_nul(db) or guild == "" { return none }
    unsafe {
        var stmt: Ptr<StoreStmt> = ptr_null()
        let sql = "SELECT group_concat(channel_id || '|' || url || '|' || last_title, char(10)) FROM (SELECT channel_id,url,last_title FROM rss_subscriptions WHERE guild_id='" + store_sql_texte(guild) + "' ORDER BY updated_at ASC LIMIT 10);"
        if sqlite3_prepare_v2(db, sql, -1, stmt, ptr_null()) != 0 { let _c = sqlite3_close(db); return none }
        let ligne = sqlite3_step(stmt) == 100
        var valeur = ""
        // group_concat() renvoie une seule colonne contenant toutes les lignes.
        // Lire les colonnes 1 et 2 ici provoquait des notifications RSS vides
        // ou invalides selon le runtime SQLite utilisé.
        if ligne and sqlite3_column_type(stmt, 0) != 5 { valeur = "" + sqlite3_column_text(stmt, 0) }
        let _f = sqlite3_finalize(stmt)
        let _c = sqlite3_close(db)
        if ligne { return some(valeur) }
        return none
    }
}

