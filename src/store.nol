// Persistance SQLite du bot. Une ligne par serveur et clé de configuration.
import "time.nol"
opaque StoreDb
opaque StoreStmt
extern fn sqlite3_close(db: Ptr<StoreDb>) -> Int depuis "sqlite3.h"

extern fn sqlite3_prepare_v2(db: Ptr<StoreDb>, sql: Text, n: Int, stmt: out Ptr<StoreStmt>, tail: Ptr) -> Int depuis "sqlite3.h"
extern fn sqlite3_step(stmt: borrow Ptr<StoreStmt>) -> Int depuis "sqlite3.h"
extern fn sqlite3_finalize(stmt: consume Ptr<StoreStmt>) -> Int depuis "sqlite3.h"
extern fn sqlite3_column_text(stmt: borrow Ptr<StoreStmt>, col: Int) -> Text depuis "sqlite3.h"
extern fn sqlite3_column_int64(stmt: borrow Ptr<StoreStmt>, col: Int) -> Int depuis "sqlite3.h"
extern fn sqlite3_column_type(stmt: borrow Ptr<StoreStmt>, col: Int) -> Int depuis "sqlite3.h"

extern fn sqlite3_open(chemin: Text, pdb: out Ptr<StoreDb>) -> Int depuis "sqlite3.h"
extern fn sqlite3_exec(db: Ptr<StoreDb>, sql: Text, cb: Ptr, arg: Ptr, err: Ptr) -> Int depuis "sqlite3.h"
extern fn sqlite3_changes(db: borrow Ptr<StoreDb>) -> Int depuis "sqlite3.h"

fn store_chemin(chemin: Text) -> Text {
    let configure = env("NOLIAE_DB_PATH")
    if has(configure) and unwrap_or(configure, "") != "" { return unwrap_or(configure, chemin) }
    return chemin
}

fn store_ouvrir(chemin: Text) -> Ptr<StoreDb> {
    unsafe {
        var db: Ptr<StoreDb> = ptr_null()
        let rc = sqlite3_open(store_chemin(chemin), db)
        if rc != 0 { return ptr_null() }
        let schema = "CREATE TABLE IF NOT EXISTS guild_config (guild_id TEXT NOT NULL, key TEXT NOT NULL, value TEXT NOT NULL, updated_at INTEGER NOT NULL, PRIMARY KEY (guild_id, key)); CREATE TABLE IF NOT EXISTS audit_log (id INTEGER PRIMARY KEY AUTOINCREMENT, guild_id TEXT NOT NULL, actor_id TEXT NOT NULL, action TEXT NOT NULL, target_id TEXT, reason TEXT, created_at INTEGER NOT NULL); CREATE TABLE IF NOT EXISTS reminders (id INTEGER PRIMARY KEY AUTOINCREMENT, guild_id TEXT NOT NULL, user_id TEXT NOT NULL, channel_id TEXT NOT NULL, content TEXT NOT NULL, due_at INTEGER NOT NULL); CREATE TABLE IF NOT EXISTS rss_subscriptions (guild_id TEXT NOT NULL, channel_id TEXT NOT NULL, url TEXT NOT NULL, last_title TEXT NOT NULL DEFAULT '', updated_at INTEGER NOT NULL, PRIMARY KEY (guild_id, url)); CREATE TABLE IF NOT EXISTS twitch_subscriptions (guild_id TEXT NOT NULL, channel_id TEXT NOT NULL, username TEXT NOT NULL, last_live INTEGER NOT NULL DEFAULT -1, updated_at INTEGER NOT NULL, PRIMARY KEY (guild_id, username)); CREATE TABLE IF NOT EXISTS invite_cache (guild_id TEXT NOT NULL, code TEXT NOT NULL, uses INTEGER NOT NULL, inviter_id TEXT NOT NULL DEFAULT '', updated_at INTEGER NOT NULL, PRIMARY KEY (guild_id, code));"
        if sqlite3_exec(db, schema, ptr_null(), ptr_null(), ptr_null()) != 0 {
            let _c = sqlite3_close(db)
            return ptr_null()
        }
        return db
    }
}

fn store_initialiser(chemin: Text) -> Bool {
    let db = store_ouvrir(chemin)
    if ptr_est_nul(db) { return false }
    unsafe { let _c = sqlite3_close(db) }
    return true
}

fn store_integrite_ok() -> Bool {
    let db = store_ouvrir("noliae-discord.sqlite3")
    if ptr_est_nul(db) { return false }
    unsafe {
        var stmt: Ptr<StoreStmt> = ptr_null()
        if sqlite3_prepare_v2(db, "PRAGMA integrity_check;", -1, stmt, ptr_null()) != 0 { let _c = sqlite3_close(db); return false }
        let ligne = sqlite3_step(stmt) == 100
        var valeur = ""
        if ligne and sqlite3_column_type(stmt, 0) != 5 { valeur = "" + sqlite3_column_text(stmt, 0) }
        let _f = sqlite3_finalize(stmt)
        let _c = sqlite3_close(db)
        return valeur == "ok"
    }
}

fn store_sql_texte(valeur: Text) -> Text {
    var out = ""
    var i = 0
    while i < len(valeur) {
        let c = sub(valeur, i, 1)
        if c == "'" { out = out + "''" } else { out = out + c }
        i = i + 1
    }
    return out
}

fn store_lire(guild: Text, cle: Text) -> Option<Text> {
    let db = store_ouvrir("noliae-discord.sqlite3")
    if ptr_est_nul(db) { return none }
    unsafe {
        var stmt: Ptr<StoreStmt> = ptr_null()
        let sql = "SELECT value FROM guild_config WHERE guild_id='" + store_sql_texte(guild) + "' AND key='" + store_sql_texte(cle) + "' LIMIT 1;"
        if sqlite3_prepare_v2(db, sql, -1, stmt, ptr_null()) != 0 {
            let _c = sqlite3_close(db)
            return none
        }
        let ligne = sqlite3_step(stmt) == 100
        var valeur = ""
        if ligne and sqlite3_column_type(stmt, 0) != 5 { valeur = "" + sqlite3_column_text(stmt, 0) }
        let _f = sqlite3_finalize(stmt)
        let _c = sqlite3_close(db)
        if ligne { return some(valeur) }
        return none
    }
}

fn store_lister_cles(guild: Text) -> Option<Text> {
    let db = store_ouvrir("noliae-discord.sqlite3")
    if ptr_est_nul(db) { return none }
    unsafe {
        var stmt: Ptr<StoreStmt> = ptr_null()
        let sql = "SELECT group_concat(key, ', ') FROM guild_config WHERE guild_id='" + store_sql_texte(guild) + "' AND key != 'verification.code' AND key NOT LIKE '_system%' AND key NOT LIKE 'privacy.suggestion.%' AND key NOT LIKE 'xp.user.%' AND key NOT LIKE 'xp.last.%' AND key NOT LIKE 'member.note.%' AND key NOT LIKE 'economy.balance.%' AND key NOT LIKE 'economy.daily.%' AND key NOT LIKE 'economy.weekly.%' AND key NOT LIKE 'economy.work.%' AND key NOT LIKE 'economy.inventory.%' AND key NOT LIKE 'music.votes.%' AND key NOT LIKE 'poll.%.vote.%' AND key NOT LIKE 'verification.pending.%';"
        if sqlite3_prepare_v2(db, sql, -1, stmt, ptr_null()) != 0 { let _c = sqlite3_close(db); return none }
        let ligne = sqlite3_step(stmt) == 100
        var valeur = ""
        if ligne and sqlite3_column_type(stmt, 0) != 5 { valeur = "" + sqlite3_column_text(stmt, 0) }
        let _f = sqlite3_finalize(stmt)
        let _c = sqlite3_close(db)
        if ligne and valeur != "" { return some(valeur) }
        return none
    }
}

// Liste bornée d’un sous-arbre de configuration sous la forme suffixe|valeur.
// Utilisée par les files persistantes qui n’ont pas besoin d’une table dédiée.
fn store_lister_prefixe(guild: Text, prefixe: Text, limite: Int) -> Option<Text> {
    let db = store_ouvrir("noliae-discord.sqlite3")
    if ptr_est_nul(db) or guild == "" or prefixe == "" or limite < 1 { return none }
    unsafe {
        var stmt: Ptr<StoreStmt> = ptr_null()
        let sql = "SELECT group_concat(substr(key," + text(len(prefixe) + 1) + ") || '|' || value, char(10)) FROM (SELECT key,value FROM guild_config WHERE guild_id='" + store_sql_texte(guild) + "' AND key LIKE '" + store_sql_texte(prefixe) + "%' ORDER BY key LIMIT " + text(limite) + ");"
        if sqlite3_prepare_v2(db, sql, -1, stmt, ptr_null()) != 0 { let _c = sqlite3_close(db); return none }
        let ligne = sqlite3_step(stmt) == 100
        var valeur = ""
        if ligne and sqlite3_column_type(stmt, 0) != 5 { valeur = "" + sqlite3_column_text(stmt, 0) }
        let _f = sqlite3_finalize(stmt)
        let _c = sqlite3_close(db)
        if valeur != "" { return some(valeur) }
        return none
    }
}

fn store_compter_cles_prefixe(guild: Text, prefixe: Text) -> Int {
    let db = store_ouvrir("noliae-discord.sqlite3")
    if ptr_est_nul(db) or guild == "" or prefixe == "" { return 0 }
    unsafe {
        var stmt: Ptr<StoreStmt> = ptr_null()
        let sql = "SELECT count(*) FROM guild_config WHERE guild_id='" + store_sql_texte(guild) + "' AND key LIKE '" + store_sql_texte(prefixe) + "%';"
        if sqlite3_prepare_v2(db, sql, -1, stmt, ptr_null()) != 0 { let _c = sqlite3_close(db); return 0 }
        let ligne = sqlite3_step(stmt) == 100
        var total = 0
        if ligne { total = sqlite3_column_int64(stmt, 0) }
        let _f = sqlite3_finalize(stmt)
        let _c = sqlite3_close(db)
        return total
    }
}

