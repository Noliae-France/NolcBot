fn store_compter_cible(guild: Text, action: Text, cible: Text) -> Int {
    let db = store_ouvrir("noliae-discord.sqlite3")
    if ptr_est_nul(db) { return 0 }
    unsafe {
        var stmt: Ptr<StoreStmt> = ptr_null()
        let sql = "SELECT count(*) FROM audit_log a WHERE a.guild_id='" + store_sql_texte(guild) + "' AND a.action='" + store_sql_texte(action) + "' AND a.target_id='" + store_sql_texte(cible) + "' AND NOT EXISTS (SELECT 1 FROM audit_log r WHERE r.guild_id=a.guild_id AND r.action='sanction_revoke' AND r.target_id=CAST(a.id AS TEXT));"
        if sqlite3_prepare_v2(db, sql, -1, stmt, ptr_null()) != 0 { let _c = sqlite3_close(db); return 0 }
        let ligne = sqlite3_step(stmt) == 100
        var total = 0
        if ligne { total = sqlite3_column_int64(stmt, 0) }
        let _f = sqlite3_finalize(stmt)
        let _c = sqlite3_close(db)
        return total
    }
}

fn store_sauver(db: Ptr<StoreDb>, guild: Text, cle: Text, valeur: Text) -> Bool {
    unsafe {
        let sql = "INSERT INTO guild_config(guild_id,key,value,updated_at) VALUES('" + store_sql_texte(guild) + "','" + store_sql_texte(cle) + "','" + store_sql_texte(valeur) + "',strftime('%s','now')) ON CONFLICT(guild_id,key) DO UPDATE SET value=excluded.value, updated_at=excluded.updated_at;"
        return sqlite3_exec(db, sql, ptr_null(), ptr_null(), ptr_null()) == 0
    }
}

fn store_rss_abonner(guild: Text, channel: Text, url: Text) -> Bool {
    let db = store_ouvrir("noliae-discord.sqlite3")
    if ptr_est_nul(db) or guild == "" or channel == "" or url == "" { return false }
    unsafe {
        let sql = "BEGIN IMMEDIATE; INSERT OR REPLACE INTO rss_subscriptions(guild_id,channel_id,url,last_title,updated_at) VALUES('" + store_sql_texte(guild) + "','" + store_sql_texte(channel) + "','" + store_sql_texte(url) + "',COALESCE((SELECT last_title FROM rss_subscriptions WHERE guild_id='" + store_sql_texte(guild) + "' AND url='" + store_sql_texte(url) + "'),''),strftime('%s','now')); COMMIT;"
        let ok = sqlite3_exec(db, sql, ptr_null(), ptr_null(), ptr_null()) == 0
        let _c = sqlite3_close(db)
        return ok
    }
}

fn store_rss_desabonner(guild: Text, url: Text) -> Bool {
    let db = store_ouvrir("noliae-discord.sqlite3")
    if ptr_est_nul(db) or guild == "" or url == "" { return false }
    unsafe {
        let ok = sqlite3_exec(db, "DELETE FROM rss_subscriptions WHERE guild_id='" + store_sql_texte(guild) + "' AND url='" + store_sql_texte(url) + "';", ptr_null(), ptr_null(), ptr_null()) == 0 and sqlite3_changes(db) == 1
        let _c = sqlite3_close(db)
        return ok
    }
}

