    }
}

fn store_rss_titre(guild: Text, url: Text, titre: Text) -> Bool {
    let db = store_ouvrir("noliae-discord.sqlite3")
    if ptr_est_nul(db) or guild == "" or url == "" { return false }
    unsafe {
        let sql = "UPDATE rss_subscriptions SET last_title='" + store_sql_texte(titre) + "',updated_at=strftime('%s','now') WHERE guild_id='" + store_sql_texte(guild) + "' AND url='" + store_sql_texte(url) + "';"
        let ok = sqlite3_exec(db, sql, ptr_null(), ptr_null(), ptr_null()) == 0
        let _c = sqlite3_close(db)
        return ok
    }
}

fn store_twitch_abonner(guild: Text, channel: Text, username: Text) -> Bool {
