// Supprime un sous-arbre de configuration sans toucher aux autres clés du serveur.
fn store_supprimer_prefixe(guild: Text, prefixe: Text) -> Bool {
    let db = store_ouvrir("noliae-discord.sqlite3")
    if ptr_est_nul(db) { return false }
    unsafe {
        let sql = "DELETE FROM guild_config WHERE guild_id='" + store_sql_texte(guild) + "' AND key LIKE '" + store_sql_texte(prefixe) + "%';"
        let ok = sqlite3_exec(db, sql, ptr_null(), ptr_null(), ptr_null()) == 0
        let _c = sqlite3_close(db)
        return ok
    }
}

fn store_supprimer_donnees(guild: Text, user: Text) -> Bool {
    let db = store_ouvrir("noliae-discord.sqlite3")
    if ptr_est_nul(db) { return false }
    unsafe {
        let sql = "DELETE FROM audit_log WHERE guild_id='" + store_sql_texte(guild) + "' AND (actor_id='" + store_sql_texte(user) + "' OR target_id='" + store_sql_texte(user) + "');"
        let sql_xp = "DELETE FROM guild_config WHERE guild_id='" + store_sql_texte(guild) + "' AND (key='xp.user." + store_sql_texte(user) + "' OR key='xp.last." + store_sql_texte(user) + "');"
        let sql_economy = "DELETE FROM guild_config WHERE guild_id='" + store_sql_texte(guild) + "' AND (key='economy.balance." + store_sql_texte(user) + "' OR key='economy.daily." + store_sql_texte(user) + "' OR key='economy.weekly." + store_sql_texte(user) + "' OR key='economy.work." + store_sql_texte(user) + "' OR key LIKE 'economy.inventory." + store_sql_texte(user) + ".%');"
        let sql_personnel = "DELETE FROM guild_config WHERE guild_id='" + store_sql_texte(guild) + "' AND (key='voice.seconds." + store_sql_texte(user) + "' OR key='voice.started." + store_sql_texte(user) + "' OR key='member.note." + store_sql_texte(user) + "' OR key LIKE 'music.votes.%." + store_sql_texte(user) + "' OR key LIKE 'poll.%.vote." + store_sql_texte(user) + "' OR key='verification.pending." + store_sql_texte(user) + "' OR key LIKE 'privacy.suggestion.%.' || '" + store_sql_texte(user) + "');"
        let sql_reminders = "DELETE FROM reminders WHERE guild_id='" + store_sql_texte(guild) + "' AND user_id='" + store_sql_texte(user) + "';"
        let ok = sqlite3_exec(db, sql, ptr_null(), ptr_null(), ptr_null()) == 0 and sqlite3_exec(db, sql_xp, ptr_null(), ptr_null(), ptr_null()) == 0 and sqlite3_exec(db, sql_economy, ptr_null(), ptr_null(), ptr_null()) == 0 and sqlite3_exec(db, sql_personnel, ptr_null(), ptr_null(), ptr_null()) == 0 and sqlite3_exec(db, sql_reminders, ptr_null(), ptr_null(), ptr_null()) == 0
        let _c = sqlite3_close(db)
        return ok
    }
}
