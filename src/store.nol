fn store_acheter(guild: Text, user: Text, objet: Text, prix: Int, quantite: Int) -> Bool {
    if guild == "" or user == "" or objet == "" or prix < 1 or quantite < 1 { return false }
    let db = store_ouvrir("noliae-discord.sqlite3")
    if ptr_est_nul(db) { return false }
    unsafe {
        let solde = "economy.balance." + user
        let inventaire = "economy.inventory." + user + "." + objet
        let cout = prix * quantite
        var ok = sqlite3_exec(db, "BEGIN IMMEDIATE;", ptr_null(), ptr_null(), ptr_null()) == 0
        ok = ok and store_sauver(db, guild, solde, "0")
        ok = ok and store_sauver(db, guild, inventaire, "0")
        if ok {
            let sql = "UPDATE guild_config SET value=CAST(value AS INTEGER)-" + text(cout) + ",updated_at=strftime('%s','now') WHERE guild_id='" + store_sql_texte(guild) + "' AND key='" + store_sql_texte(solde) + "' AND CAST(value AS INTEGER) >= " + text(cout) + ";"
            ok = sqlite3_exec(db, sql, ptr_null(), ptr_null(), ptr_null()) == 0 and sqlite3_changes(db) == 1
        }
        if ok {
            let sql = "UPDATE guild_config SET value=CAST(value AS INTEGER)+" + text(quantite) + ",updated_at=strftime('%s','now') WHERE guild_id='" + store_sql_texte(guild) + "' AND key='" + store_sql_texte(inventaire) + "';"
            ok = sqlite3_exec(db, sql, ptr_null(), ptr_null(), ptr_null()) == 0 and sqlite3_changes(db) == 1
        }
        if ok { ok = sqlite3_exec(db, "COMMIT;", ptr_null(), ptr_null(), ptr_null()) == 0 } else { let _rollback = sqlite3_exec(db, "ROLLBACK;", ptr_null(), ptr_null(), ptr_null()) }
        let _c = sqlite3_close(db)
        return ok
    }
}

