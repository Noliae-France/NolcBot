fn store_definir_solde(guild: Text, user: Text, montant: Int) -> Bool {
    if guild == "" or user == "" or montant < 0 { return false }
    return store_configurer(guild, "economy.balance." + user, text(montant))
}

fn store_ajouter_solde(guild: Text, user: Text, montant: Int) -> Int {
    let actuel = store_solde(guild, user)
    let nouveau = actuel + montant
    if nouveau < 0 { return actuel }
    if store_definir_solde(guild, user, nouveau) { return nouveau }
    return actuel
}

fn store_transferer(guild: Text, source: Text, cible: Text, montant: Int) -> Bool {
    if guild == "" or source == "" or cible == "" or source == cible or montant < 1 { return false }
    let db = store_ouvrir("noliae-discord.sqlite3")
    if ptr_est_nul(db) { return false }
    unsafe {
        let g = store_sql_texte(guild)
        let s = store_sql_texte(source)
        let c = store_sql_texte(cible)
        let cle_source = "economy.balance." + s
        let cle_cible = "economy.balance." + c
        var ok = sqlite3_exec(db, "BEGIN IMMEDIATE;", ptr_null(), ptr_null(), ptr_null()) == 0
        ok = ok and sqlite3_exec(db, "INSERT OR IGNORE INTO guild_config(guild_id,key,value,updated_at) VALUES('" + g + "','" + cle_source + "','0',strftime('%s','now'));", ptr_null(), ptr_null(), ptr_null()) == 0
        ok = ok and sqlite3_exec(db, "INSERT OR IGNORE INTO guild_config(guild_id,key,value,updated_at) VALUES('" + g + "','" + cle_cible + "','0',strftime('%s','now'));", ptr_null(), ptr_null(), ptr_null()) == 0
        if ok { ok = sqlite3_exec(db, "UPDATE guild_config SET value=CAST(value AS INTEGER)-" + text(montant) + ",updated_at=strftime('%s','now') WHERE guild_id='" + g + "' AND key='" + cle_source + "' AND CAST(value AS INTEGER) >= " + text(montant) + ";", ptr_null(), ptr_null(), ptr_null()) == 0 and sqlite3_changes(db) == 1 }
        if ok { ok = sqlite3_exec(db, "UPDATE guild_config SET value=CAST(value AS INTEGER)+" + text(montant) + ",updated_at=strftime('%s','now') WHERE guild_id='" + g + "' AND key='" + cle_cible + "';", ptr_null(), ptr_null(), ptr_null()) == 0 and sqlite3_changes(db) == 1 }
        if ok { ok = sqlite3_exec(db, "COMMIT;", ptr_null(), ptr_null(), ptr_null()) == 0 } else { let _rollback = sqlite3_exec(db, "ROLLBACK;", ptr_null(), ptr_null(), ptr_null()) }
        let _c = sqlite3_close(db)
        return ok
    }
}

fn store_creer_rappel(guild: Text, user: Text, channel: Text, contenu: Text, echeance: Int) -> Bool {
    let db = store_ouvrir("noliae-discord.sqlite3")
    if ptr_est_nul(db) or guild == "" or user == "" or channel == "" or contenu == "" or echeance < 1 { return false }
    unsafe {
        let sql = "INSERT INTO reminders(guild_id,user_id,channel_id,content,due_at) VALUES('" + store_sql_texte(guild) + "','" + store_sql_texte(user) + "','" + store_sql_texte(channel) + "','" + store_sql_texte(contenu) + "'," + text(echeance) + ");"
        let ok = sqlite3_exec(db, sql, ptr_null(), ptr_null(), ptr_null()) == 0
        let _c = sqlite3_close(db)
        return ok
    }
}

fn store_dernier_rappel(guild: Text, user: Text) -> Int {
    let db = store_ouvrir("noliae-discord.sqlite3")
    if ptr_est_nul(db) or guild == "" or user == "" { return 0 }
    unsafe {
        var stmt: Ptr<StoreStmt> = ptr_null()
        let sql = "SELECT id FROM reminders WHERE guild_id='" + store_sql_texte(guild) + "' AND user_id='" + store_sql_texte(user) + "' ORDER BY id DESC LIMIT 1;"
        if sqlite3_prepare_v2(db, sql, -1, stmt, ptr_null()) != 0 { let _c = sqlite3_close(db); return 0 }
        let ligne = sqlite3_step(stmt) == 100
        var id = 0
        if ligne { id = sqlite3_column_int64(stmt, 0) }
        let _f = sqlite3_finalize(stmt)
        let _c = sqlite3_close(db)
        return id
    }
}

fn store_lister_rappels(guild: Text, user: Text) -> Option<Text> {
    let db = store_ouvrir("noliae-discord.sqlite3")
    if ptr_est_nul(db) or guild == "" or user == "" { return none }
    unsafe {
        var stmt: Ptr<StoreStmt> = ptr_null()
        let sql = "SELECT group_concat(CAST(id AS TEXT) || ':' || CAST(due_at AS TEXT), ', ') FROM reminders WHERE guild_id='" + store_sql_texte(guild) + "' AND user_id='" + store_sql_texte(user) + "' ORDER BY due_at ASC;"
        if sqlite3_prepare_v2(db, sql, -1, stmt, ptr_null()) != 0 { let _c = sqlite3_close(db); return none }
        let ligne = sqlite3_step(stmt) == 100
        var valeur = ""
        if ligne and sqlite3_column_type(stmt, 0) != 5 { valeur = sqlite3_column_text(stmt, 0) }
        let _f = sqlite3_finalize(stmt)
        let _c = sqlite3_close(db)
        if ligne and valeur != "" { return some(valeur) }
        return none
    }
}

fn store_rappel_du(guild: Text) -> Option<Text> {
    let db = store_ouvrir("noliae-discord.sqlite3")
    if ptr_est_nul(db) { return none }
    unsafe {
        var stmt: Ptr<StoreStmt> = ptr_null()
        let sql = "SELECT id,user_id,channel_id,content FROM reminders WHERE guild_id='" + store_sql_texte(guild) + "' AND due_at <= " + text(epoch_maintenant()) + " ORDER BY due_at ASC LIMIT 1;"
        if sqlite3_prepare_v2(db, sql, -1, stmt, ptr_null()) != 0 { let _c = sqlite3_close(db); return none }
        let ligne = sqlite3_step(stmt) == 100
        var valeur = ""
        if ligne { valeur = text(sqlite3_column_int64(stmt, 0)) + "|" + sqlite3_column_text(stmt, 1) + "|" + sqlite3_column_text(stmt, 2) + "|" + sqlite3_column_text(stmt, 3) }
        let _f = sqlite3_finalize(stmt)
        let _c = sqlite3_close(db)
        if ligne { return some(valeur) }
        return none
    }
}

fn store_lister_guildes() -> Option<Text> {
    let db = store_ouvrir("noliae-discord.sqlite3")
    if ptr_est_nul(db) { return none }
    unsafe {
        var stmt: Ptr<StoreStmt> = ptr_null()
        let sql = "SELECT group_concat(guild_id, ',') FROM (SELECT guild_id FROM guild_config WHERE guild_id != '_system' UNION SELECT guild_id FROM reminders WHERE guild_id != '_system' UNION SELECT guild_id FROM rss_subscriptions WHERE guild_id != '_system' UNION SELECT guild_id FROM twitch_subscriptions WHERE guild_id != '_system' UNION SELECT guild_id FROM audit_log WHERE guild_id != '_system' ORDER BY guild_id);"
        if sqlite3_prepare_v2(db, sql, -1, stmt, ptr_null()) != 0 { let _c = sqlite3_close(db); return none }
        let ligne = sqlite3_step(stmt) == 100
        var valeur = ""
        if ligne and sqlite3_column_type(stmt, 0) != 5 { valeur = sqlite3_column_text(stmt, 0) }
        let _f = sqlite3_finalize(stmt)
        let _c = sqlite3_close(db)
        if ligne and valeur != "" { return some(valeur) }
        return none
    }
}

