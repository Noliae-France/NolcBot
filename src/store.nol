fn store_observer_invitation(guild: Text, code: Text, uses: Int, inviter: Text) -> Int {
    let db = store_ouvrir("noliae-discord.sqlite3")
    if ptr_est_nul(db) or guild == "" or code == "" or uses < 0 { return -1 }
    unsafe {
        var stmt: Ptr<StoreStmt> = ptr_null()
        let sql = "SELECT uses FROM invite_cache WHERE guild_id='" + store_sql_texte(guild) + "' AND code='" + store_sql_texte(code) + "' LIMIT 1;"
        if sqlite3_prepare_v2(db, sql, -1, stmt, ptr_null()) != 0 { let _c = sqlite3_close(db); return -1 }
        let ligne = sqlite3_step(stmt) == 100
        var ancien = -1
        if ligne { ancien = sqlite3_column_int64(stmt, 0) }
        let _f = sqlite3_finalize(stmt)
        let sauvegarde = "INSERT OR REPLACE INTO invite_cache(guild_id,code,uses,inviter_id,updated_at) VALUES('" + store_sql_texte(guild) + "','" + store_sql_texte(code) + "'," + text(uses) + ",'" + store_sql_texte(inviter) + "',strftime('%s','now'));"
        if sqlite3_exec(db, sauvegarde, ptr_null(), ptr_null(), ptr_null()) != 0 { let _c = sqlite3_close(db); return -1 }
        let _c = sqlite3_close(db)
        return ancien
    }
}

