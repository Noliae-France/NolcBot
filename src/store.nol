fn store_ajouter_xp(guild: Text, user: Text, points: Int) -> Int {
    if guild == "" or user == "" or points < 1 { return 0 }
    let cle = "xp.user." + user
    let actuel = unwrap_or(parse_int(unwrap_or(store_lire(guild, cle), "0")), 0)
    let nouveau = actuel + points
    if store_configurer(guild, cle, text(nouveau)) { return nouveau }
    return actuel
}

fn store_solde(guild: Text, user: Text) -> Int {
    return unwrap_or(parse_int(unwrap_or(store_lire(guild, "economy.balance." + user), "0")), 0)
}

fn store_reclamer_daily(guild: Text, user: Text, maintenant: Int) -> Int {
    if guild == "" or user == "" or maintenant < 1 { return -1 }
    let db = store_ouvrir("noliae-discord.sqlite3")
    if ptr_est_nul(db) { return -1 }
    unsafe {
        let balance = "economy.balance." + user
        let quotidien = "economy.daily." + user
        var ok = sqlite3_exec(db, "BEGIN IMMEDIATE;", ptr_null(), ptr_null(), ptr_null()) == 0
        ok = ok and store_sauver(db, guild, balance, "0")
        ok = ok and store_sauver(db, guild, quotidien, "0")
        if ok {
            let sql = "UPDATE guild_config SET value='" + text(maintenant) + "',updated_at=strftime('%s','now') WHERE guild_id='" + store_sql_texte(guild) + "' AND key='" + store_sql_texte(quotidien) + "' AND CAST(value AS INTEGER) <= " + text(maintenant - 86400) + ";"
            ok = sqlite3_exec(db, sql, ptr_null(), ptr_null(), ptr_null()) == 0 and sqlite3_changes(db) == 1
        }
        if ok {
            let sql = "UPDATE guild_config SET value=CAST(value AS INTEGER)+100,updated_at=strftime('%s','now') WHERE guild_id='" + store_sql_texte(guild) + "' AND key='" + store_sql_texte(balance) + "';"
            ok = sqlite3_exec(db, sql, ptr_null(), ptr_null(), ptr_null()) == 0 and sqlite3_changes(db) == 1
        }
        if ok { ok = sqlite3_exec(db, "COMMIT;", ptr_null(), ptr_null(), ptr_null()) == 0 } else { let _rollback = sqlite3_exec(db, "ROLLBACK;", ptr_null(), ptr_null(), ptr_null()) }
        let _c = sqlite3_close(db)
        if ok { return store_solde(guild, user) }
        return -1
    }
}

