fn store_ajouter_temps_vocal(guild: Text, user: Text, secondes: Int) -> Bool {
    if guild == "" or user == "" or secondes < 1 { return false }
    let cle = "voice.seconds." + user
    let actuel = unwrap_or(parse_int(unwrap_or(store_lire(guild, cle), "0")), 0)
    return store_configurer(guild, cle, text(actuel + secondes))
}

fn store_compter_recent(guild: Text, action: Text, secondes: Int) -> Int {
    let db = store_ouvrir("noliae-discord.sqlite3")
    if ptr_est_nul(db) or secondes < 1 { return 0 }
    unsafe {
        var stmt: Ptr<StoreStmt> = ptr_null()
        let depuis = epoch_maintenant() - secondes
        let sql = "SELECT count(*) FROM audit_log WHERE guild_id='" + store_sql_texte(guild) + "' AND action='" + store_sql_texte(action) + "' AND created_at >= " + text(depuis) + ";"
        if sqlite3_prepare_v2(db, sql, -1, stmt, ptr_null()) != 0 {
            let _c = sqlite3_close(db)
            return 0
        }
        let ligne = sqlite3_step(stmt) == 100
        var total = 0
        if ligne { total = sqlite3_column_int64(stmt, 0) }
        let _f = sqlite3_finalize(stmt)
        let _c = sqlite3_close(db)
        return total
    }
}

